{
  "name": "portafolio-jorge-quenta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && eslint . --max-warnings 0 && node scripts/verificar-tokens.mjs",
    "test": "vitest run",
    "format": "prettier --write src scripts tests astro.config.ts eslint.config.js vitest.config.ts package.json tsconfig.json .github/workflows/ci.yml",
    "contenido:pendientes": "node scripts/contenido-pendientes.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
