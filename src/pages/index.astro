---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Indice from '../components/portada/Indice.astro';
import SobreMi from '../components/portada/SobreMi.astro';
import Tecnologias from '../components/portada/Tecnologias.astro';
import Notas from '../components/portada/Notas.astro';
import Contacto from '../components/portada/Contacto.astro';
import { hayNotasPublicadas, obtenerProyectos } from '../content/consultas';
import { ordenarProyectos } from '../content/validacion';
import { seccionesVisibles } from '../config/secciones';
import { t } from '../i18n';
import { IDIOMA_BASE } from '../i18n/config';
const idioma = IDIOMA_BASE;
const perfil = (await getEntry('perfil', idioma))!.data;
const secciones = seccionesVisibles(await hayNotasPublicadas(idioma));
const proyectos = ordenarProyectos(
  (await obtenerProyectos(idioma)).filter((p) => p.data.estado !== 'archivado'),
);
const tecnologias = (await getEntry('tecnologias', idioma))!.data;
const notas = secciones.some((s) => s.id === 'notas')
  ? (await getCollection('notas'))
      .filter((n) => n.id.startsWith(`${idioma}/`) && !n.data.borrador)
      .sort((a, b) => b.data.fecha.localeCompare(a.data.fecha))
  : [];
---

<BaseLayout
  titulo={perfil.nombre}
  descripcion={perfil.presentacion}
  idioma={idioma}
  tema="cosmos"
  portada
>
  {secciones.map((seccion) => (
    <section
      id={seccion.ancla || 'inicio'}
      class:list={['seccion', seccion.id]}
      aria-labelledby={`${seccion.id}-titulo`}
      data-seccion-portada={seccion.id}
      data-hero={seccion.id === 'hero' || undefined}
    >
      <div class="interior">
        {seccion.id === 'hero' ? (
          <h1 id="hero-titulo" class="visualmente-oculto">
            {perfil.nombre}
          </h1>
        ) : seccion.id === 'proyectos' ? (
          <h2 id="proyectos-titulo" class="visualmente-oculto" tabindex="-1">
            {t(idioma, seccion.clave)}
          </h2>
        ) : seccion.id === 'indice' ? (
          <Indice seccion={seccion} idioma={idioma} proyectos={proyectos} />
        ) : seccion.id === 'sobre-mi' ? (
          <SobreMi seccion={seccion} idioma={idioma} perfil={perfil} />
        ) : seccion.id === 'tecnologias' ? (
          <Tecnologias
            seccion={seccion}
            idioma={idioma}
            tecnologias={tecnologias}
            proyectos={proyectos}
          />
        ) : seccion.id === 'notas' ? (
          <Notas seccion={seccion} idioma={idioma} notas={notas} />
        ) : (
          <Contacto seccion={seccion} idioma={idioma} perfil={perfil} />
        )}
        {(seccion.id === 'hero' || seccion.id === 'proyectos') && (
          <div
            data-reservado={
              seccion.id === 'hero'
                ? 'F6'
                : seccion.id === 'proyectos'
                  ? 'F5'
                  : undefined
            }
            aria-hidden="true"
          ></div>
        )}
      </div>
    </section>
  ))}
</BaseLayout>
<style>
  .indice,
  .sobre-mi,
  .tecnologias,
  .notas,
  .contacto {
    -webkit-font-smoothing: antialiased;
  }
  .seccion {
    padding-top: var(--section-gap);
  }
  .interior {
    max-width: calc(var(--content-max) + 2 * var(--page-margin));
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
  .hero {
    min-height: var(--hero-min);
    padding: 0;
  }
  .proyectos {
    min-height: var(--stories-min);
  }
  .indice {
    padding-top: var(--index-gap);
  }
  .contacto {
    position: relative;
    isolation: isolate;
    min-height: var(--contact-min);
    margin-top: var(--section-gap);
    padding-top: 0;
  }
  @media (max-width: 1199px) {
    .seccion {
      padding-top: var(--section-gap-tablet);
    }
    .hero {
      padding-top: 0;
    }
    .contacto {
      margin-top: var(--section-gap-tablet);
      padding-top: 0;
    }
    .interior {
      padding-inline: var(--space-6);
    }
  }
  @media (max-width: 767px) {
    .seccion {
      padding-top: var(--section-gap-mobile);
    }
    .hero {
      padding-top: 0;
    }
    .contacto {
      margin-top: var(--section-gap-mobile);
      min-height: 0;
      padding-top: 0;
    }
    .interior {
      padding-inline: var(--page-margin-mobile);
    }
  }
</style>
