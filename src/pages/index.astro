---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { obtenerProyectos } from '../content/consultas';
import { ruta } from '../i18n';
import { IDIOMA_BASE } from '../i18n/config';

const perfil = (await getEntry('perfil', IDIOMA_BASE))!;
const proyectos = await obtenerProyectos(IDIOMA_BASE);
---

<BaseLayout
  titulo={perfil.data.frase_hero}
  descripcion={perfil.data.presentacion}
  idioma={IDIOMA_BASE}
  tema="cosmos"
>
  <h1>{perfil.data.frase_hero}</h1>
  <ul>
    {proyectos.map((proyecto) => (
      <li>
        <a href={ruta(IDIOMA_BASE, `/proyectos/${proyecto.slug}`)}>
          {proyecto.data.titulo}
        </a>
        <span>{proyecto.data.tipo}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
