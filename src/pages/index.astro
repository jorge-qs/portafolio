---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EncabezadoSeccion from '../components/EncabezadoSeccion.astro';
import { hayNotasPublicadas } from '../content/consultas';
import { seccionesVisibles } from '../config/secciones';
import { t } from '../i18n';
import { IDIOMA_BASE } from '../i18n/config';
const idioma = IDIOMA_BASE;
const perfil = (await getEntry('perfil', idioma))!.data;
const secciones = seccionesVisibles(await hayNotasPublicadas(idioma));
---

<BaseLayout
  titulo={perfil.nombre}
  descripcion={perfil.presentacion}
  idioma={idioma}
  tema="cosmos"
  portada
>
  {secciones.map((seccion) => (
    <section
      id={seccion.ancla || 'inicio'}
      class:list={['seccion', seccion.id]}
      aria-labelledby={`${seccion.id}-titulo`}
      data-seccion-portada={seccion.id}
      data-hero={seccion.id === 'hero' || undefined}
    >
      <div class="interior">
        {seccion.id === 'hero' ? (
          <h1 id="hero-titulo" class="visualmente-oculto">
            {perfil.nombre}
          </h1>
        ) : seccion.id === 'proyectos' ? (
          <h2 id="proyectos-titulo" class="visualmente-oculto" tabindex="-1">
            {t(idioma, seccion.clave)}
          </h2>
        ) : (
          <EncabezadoSeccion seccion={seccion} idioma={idioma} />
        )}
        <div
          data-reservado={
            seccion.id === 'hero'
              ? 'F6'
              : seccion.id === 'proyectos'
                ? 'F5'
                : 'F2'
          }
          aria-hidden="true"
        ></div>
      </div>
    </section>
  ))}
</BaseLayout>
<style>
  .seccion {
    padding-top: var(--section-gap);
  }
  .interior {
    max-width: calc(var(--content-max) + 2 * var(--page-margin));
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
  .hero {
    min-height: var(--hero-min);
    padding: 0;
  }
  .proyectos {
    min-height: var(--stories-min);
  }
  .indice {
    min-height: var(--index-min);
    padding-top: var(--index-gap);
  }
  .sobre-mi {
    min-height: var(--about-min);
  }
  .tecnologias {
    min-height: var(--technologies-min);
  }
  .notas {
    min-height: var(--notes-min);
  }
  .contacto {
    min-height: var(--contact-min);
  }
  @media (max-width: 1199px) {
    .seccion {
      padding-top: var(--section-gap-tablet);
    }
    .hero {
      padding-top: 0;
    }
    .interior {
      padding-inline: var(--space-6);
    }
  }
  @media (max-width: 767px) {
    .seccion {
      padding-top: var(--section-gap-mobile);
    }
    .hero {
      padding-top: 0;
    }
    .interior {
      padding-inline: var(--page-margin-mobile);
    }
  }
</style>
