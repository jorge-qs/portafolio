---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { obtenerProyectos } from '../../content/consultas';
import { IDIOMA_BASE } from '../../i18n/config';
import { t } from '../../i18n';

export async function getStaticPaths() {
  return (await obtenerProyectos(IDIOMA_BASE)).map((proyecto) => ({
    params: { slug: proyecto.slug },
    props: { proyecto },
  }));
}
const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
---

<BaseLayout
  titulo={proyecto.data.titulo}
  descripcion={proyecto.data.resumen}
  idioma={proyecto.idioma}
  tema="elegible"
>
  {proyecto.esRespaldo && <p>{t(proyecto.idioma, 'idiomaRespaldo')}</p>}
  <h1>{proyecto.data.titulo}</h1>
  <p>{proyecto.data.resumen}</p>
  <Content />
</BaseLayout>
