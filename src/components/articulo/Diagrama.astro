---
import { t } from '../../i18n';
import type { Idioma } from '../../i18n/config';
import type { ModeloDiagrama } from '../../lib/diagrama';
import Enlace from '../Enlace.astro';
import DiagramaSVG from '../DiagramaSVG.astro';
interface Props {
  modelo: ModeloDiagrama;
  descripcion: string;
  idioma?: Idioma;
}
const { modelo, descripcion, idioma = 'es' } = Astro.props;
const seleccionado =
  modelo.nodos.find((n) => n.id === modelo.seleccionado) ?? modelo.nodos[0];
---

<figure class="diagrama ancho">
  <div class="miniatura">
    <div class="lienzo">
      <DiagramaSVG modelo={modelo} />
    </div>
    <figcaption>{t(idioma, 'articulo.diagrama', { n: 1 })}</figcaption>
    <button type="button" hidden>
      {t(idioma, 'articulo.explorar')}
    </button>
    <span class="visualmente-oculto">{descripcion}</span>
  </div>
  <div class="panel">
    <p class="kicker">{t(idioma, 'articulo.seleccionado')}</p>
    <h3>{seleccionado.etiqueta}</h3>
    <dl>
      {(['responsabilidad', 'entradas_salidas', 'cumple'] as const).map((k) => (
        <div>
          <dt>
            {t(idioma, `articulo.${k === 'entradas_salidas' ? 'entradas' : k}`)}
          </dt>
          <dd>{seleccionado[k]}</dd>
        </div>
      ))}
    </dl>
    {seleccionado.codigo && (
      <Enlace href={seleccionado.codigo} idioma={idioma}>
        {t(idioma, 'articulo.verCodigo')}
      </Enlace>
    )}
  </div>
</figure>
<style>
  figure {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--diagram-panel);
    margin: 0;
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .miniatura {
    position: relative;
    min-width: 0;
    padding: var(--space-4);
  }
  .lienzo {
    height: calc(var(--diagram-height) - 2 * var(--space-4));
  }
  figcaption {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
  }
  .panel {
    background: var(--surface-2);
    padding: var(--space-5);
    font-size: var(--text-meta);
  }
  .panel h3 {
    font-size: var(--article-deck);
    margin-block: var(--space-3);
    font-weight: 600;
  }
  .kicker,
  dt,
  figcaption {
    color: var(--muted);
  }
  .kicker,
  figcaption {
    font-size: var(--text-kicker);
  }
  dl {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  dd {
    margin: 0;
  }
  @media (max-width: 767px) {
    figure {
      display: block;
    }
    .lienzo {
      height: calc(var(--diagram-mobile-height) - 2 * var(--space-4));
    }
    .panel {
      display: none;
    }
  }
</style>
