---
import '../styles/tokens.css';
import '../styles/global.css';
import { t } from '../i18n';
import type { Idioma } from '../i18n/config';
import { getEntry } from 'astro:content';
import { hayNotasPublicadas } from '../content/consultas';
import BarraGlobal from '../components/BarraGlobal.astro';
import MenuMovil from '../components/MenuMovil.astro';
import PiePagina from '../components/PiePagina.astro';

interface Props {
  titulo: string;
  descripcion: string;
  idioma: Idioma;
  tema: 'cosmos' | 'elegible';
  portada?: boolean;
  tipo?: 'ing' | 'inv' | 'hib';
}
const {
  titulo,
  descripcion,
  idioma,
  tema,
  portada = false,
  tipo,
} = Astro.props;
const perfil = (await getEntry('perfil', 'es'))!.data;
const hayNotas = await hayNotasPublicadas(idioma);
---

<!doctype html>
<html lang={idioma} data-theme="cosmos">
  <head>
    <meta charset="UTF-8" />
    {tema === 'elegible' && <script is:inline>
      try {
        const preferencia = localStorage.getItem('tema');
        const tema =
          preferencia === 'sistema'
            ? matchMedia('(prefers-color-scheme: light)').matches
              ? 'dawn'
              : 'cosmos'
            : preferencia === 'dawn'
              ? 'dawn'
              : 'cosmos';
        document.documentElement.dataset.theme = tema;
      } catch {
        document.documentElement.dataset.theme = 'cosmos';
      }
    </script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
    <link
      rel="preload"
      href="/fonts/geist-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="saltar-contenido" href="#contenido">
      {t(idioma, 'saltarContenido')}
    </a>
    <header>
      <slot name="header">
        <BarraGlobal
          perfil={perfil}
          idioma={idioma}
          hayNotas={hayNotas}
          portada={portada}
          tipo={tipo}
        />
      </slot>
    </header>
    <main id="contenido" class:list={{ portada }} tabindex="-1">
      <slot />
    </main>
    <footer>
      <slot name="footer">
        <PiePagina perfil={perfil} idioma={idioma} portada={portada} />
      </slot>
    </footer>
    <MenuMovil
      perfil={perfil}
      idioma={idioma}
      hayNotas={hayNotas}
      portada={portada}
    />
    <script>
      import { iniciarNavegacion } from '../lib/navegacion';
      iniciarNavegacion();
    </script>
  </body>
</html>
